#include <stdio.h>

int main() {
    int x, y;

    // Get two numbers from the user
    printf("Enter two numbers: ");
    scanf("%d %d", &x, &y);

    // Calculations
    printf("Sum: %d\n", x + y);
    printf("Difference: %d\n", x - y);
    printf("Product: %d\n", x * y);
    printf("Quotient: %d\n", x / y);
    printf("Remainder: %d\n", x % y);

    return 0;
}